<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Translator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F9FC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown by the system while the app starts: brand blue with the logo, which the animated intro continues from. -->
    <style name="Theme.Translator.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1457F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Translator</item>
        <!-- White status bar icons on the blue splash. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
